{
  "name": "just-browser",
  "version": "0.1.0",
  "description": "100% WASMable browser environment combining just-bash, agent-browser, and Cloudflare Kitesurf in-process",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "bin": {
    "just-browser": "./dist/bin/just-browser.js"
  },
  "scripts": {
    "build:kitesurf": "node scripts/build-kitesurf-bundles.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "devtools-protocol": "0.0.1669207",
    "es-module-lexer": "^2.1.0",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.13.12",
    "just-bash": "^3.6.0",
    "nanoid": "^6.0.1",
    "web-bot-auth": "^0.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.27.7",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
